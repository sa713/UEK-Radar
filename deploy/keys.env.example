# Copy to /etc/uek-radar/keys.env; set chmod 600, owner root.
# Telegram bot domain must match SITE_ORIGIN, with HTTPS.
DOMAIN=radar.example.org
SITE_ORIGIN=https://radar.example.org
TELEGRAM_BOT_USERNAME=examplebot
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_USERNAME=example_admin
SESSION_SECRET=
CRON_SECRET=
OPENAI_API_KEY=
